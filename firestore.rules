rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function canRead() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Retrieve clinicId from the user's document in the users collection
    function getClinicId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId;
    }

    // Verify if clinicId matches between incoming/existing resource and the user's assigned clinic
    function hasClinicAccess(data) {
      return isSignedIn() && (data.clinicId == getClinicId());
    }

    // Rules for individual collections
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == resource.data.clinicId);
      allow create: if isSignedIn() && (request.auth.uid == userId);
      allow update: if isSignedIn() && (request.auth.uid == userId);
      allow delete: if isSignedIn() && (request.auth.uid == userId);
    }

    match /clinics/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid);
    }

    match /patients/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /appointments/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /prescriptions/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /prescription_items/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /diagnoses/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /lab_results/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /lab_requests/{id} {
      allow read, write: if isSignedIn();
    }

    match /vitals/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /physical_exams/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /pharmacy_inventory/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /pharmacy_batches/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /notifications/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /templates/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /tasks/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /mental_health_assessments/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /obstetric_records/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /internal_messages/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /clinical_drafts/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /patient_notes/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /chat_messages/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }

    match /saved_knowledge/{id} {
      allow read: if hasClinicAccess(resource.data);
      allow create: if hasClinicAccess(request.resource.data);
      allow update: if hasClinicAccess(resource.data) && hasClinicAccess(request.resource.data);
      allow delete: if hasClinicAccess(resource.data);
    }
  }
}
