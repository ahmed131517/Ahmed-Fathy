{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores basic user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth unique ID" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's full name" },
        "role": { "type": "string", "enum": ["doctor", "nurse", "pharmacist", "receptionist", "admin"], "description": "User's role in the system" },
        "clinicId": { "type": "string", "description": "ID of the clinic this user belongs to" },
        "clinicName": { "type": "string", "description": "Name of the clinic this user belongs to" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was created" }
      },
      "required": ["uid", "email"]
    },
    "Patient": {
      "title": "Patient Record",
      "description": "Clinical record of a patient including medical history and contact.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clinicId": { "type": "string" },
        "name": { "type": "string" },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "bloodType": { "type": "string" },
        "lastVisit": { "type": "string" },
        "status": { "type": "string" },
        "lastModified": { "type": "number" },
        "isDeleted": { "type": "number" }
      },
      "required": ["id", "clinicId", "name"]
    },
    "Appointment": {
      "title": "Appointment Record",
      "description": "Information about patient appointments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clinicId": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "doctor": { "type": "string" },
        "lastModified": { "type": "number" },
        "isDeleted": { "type": "number" }
      },
      "required": ["id", "clinicId", "patientId", "date", "time"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents with SaaS clinic isolation context."
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Clinical patients records."
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Schedules and meetings matching clinics."
    }
  }
}
